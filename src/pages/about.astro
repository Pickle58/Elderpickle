---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { siteConfig } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description={`About ${siteConfig.name} — mission and approach.`}>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
      <div class="space-y-6">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About {siteConfig.name}</h1>
        <p class="text-lg text-muted-foreground">
          We build calm, fast marketing sites with Astro, Tailwind, and carefully hydrated UI.
          The palette stays dark: deep navy surfaces, blue actions, and orange accents.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <Card>
            <CardHeader>
              <CardTitle>Mission</CardTitle>
              <CardDescription>Ship clear stories without heavy client JS.</CardDescription>
            </CardHeader>
            <CardContent class="text-sm text-muted-foreground">
              Static HTML by default. Islands only where interaction earns its keep — like the
              mobile navigation sheet.
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Approach</CardTitle>
              <CardDescription>Content collections, SEO basics, Cloud Run ready.</CardDescription>
            </CardHeader>
            <CardContent class="text-sm text-muted-foreground">
              Blog posts live in Markdown. Sitemap and robots are generated at build time. Docker
              serves the static `dist` folder behind nginx on Cloud Run.
            </CardContent>
          </Card>
        </div>
      </div>

      <figure class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <img
          src={siteConfig.heroPoster}
          alt="Elderpickle navy and orange poster still"
          class="h-auto w-full object-cover"
          width="960"
          height="540"
          loading="lazy"
        />
        <figcaption class="border-t border-border px-4 py-3 text-sm text-muted-foreground">
          Poster art doubles as the hero fallback when video is missing or motion is reduced.
        </figcaption>
      </figure>
    </div>
  </div>
</BaseLayout>
