# SITE_ADDRESS: your public hostname (e.g. elderpickle.example.com).
# Local HTTP smoke test without TLS: SITE_ADDRESS=:80
{$SITE_ADDRESS} {
	root * /srv
	encode gzip zstd
	route {
		try_files {path} {path}/ {path}.html /index.html

		@static {
			path *.css *.js *.jpg *.jpeg *.gif *.png *.svg *.ico *.webp *.woff *.woff2
		}
		header @static Cache-Control "public, max-age=604800, immutable"

		@video {
			path *.mp4
		}
		header @video Cache-Control "public, max-age=604800"
		header @video Accept-Ranges bytes

		file_server
	}
}
